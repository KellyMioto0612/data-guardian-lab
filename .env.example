DATA_PROVIDER=demo
# auto: Workload Identity in CI/AKS, Managed Identity in Azure, Azure CLI locally.
AZURE_AUTH_MODE=auto
# Optional non-secret client ID for a user-assigned managed identity or federation.
AZURE_CLIENT_ID=
# Required only for workload_identity; supplied by the CI/Kubernetes platform.
AZURE_TENANT_ID=
AZURE_FEDERATED_TOKEN_FILE=
SYNAPSE_WORKSPACE=
# Janela máxima de consulta: 1 a 168 horas; o padrão é 24 horas.
SYNAPSE_LOOKBACK_HOURS=24
# Caminho local relativo ao projeto; o scanner recusa diretórios externos.
SQL_SCAN_PATH=tests/fixtures/sql
